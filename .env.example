# ==============================================================================
# Veritolytics / Veritopinion - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables to suit your local or cloud environment.
# Note: For standard XAMPP installations, default values below work out of the box.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Standard Local XAMPP MySQL)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=veritolytics_db
DB_USER=root
DB_PASS=

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE: CLOUD DATABASE CONNECTION STRING (Railway / PlanetScale / TiDB)
# ------------------------------------------------------------------------------
# If deploying to Railway, Vercel, or a cloud PaaS, you can provide a single URL:
# DATABASE_URL=mysql://root:password@containers-us-west-1.railway.app:7342/railway

# ------------------------------------------------------------------------------
# 3. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/veritolytics
