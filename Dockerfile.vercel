# ==============================================================================
# VERITOLYTICS - VERCEL CONTAINER DEPLOYMENT (FRANKENPHP + PHP 8.2)
# ==============================================================================

FROM dunglas/frankenphp:1-php8.2-alpine

# Set container working directory
WORKDIR /app

# Install system dependencies (ca-certificates for cloud DB SSL, tzdata)
RUN apk add --no-cache ca-certificates tzdata

# Install production PHP extensions
RUN install-php-extensions \
    pdo_mysql \
    pdo_sqlite \
    opcache

# Use production php.ini
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Configure production PHP directives
RUN { \
    echo 'memory_limit = 256M'; \
    echo 'upload_max_filesize = 16M'; \
    echo 'post_max_size = 16M'; \
    echo 'session.save_path = "/tmp"'; \
    echo 'session.gc_maxlifetime = 604800'; \
    echo 'opcache.enable = 1'; \
    echo 'opcache.memory_consumption = 128'; \
    echo 'opcache.interned_strings_buffer = 8'; \
    echo 'opcache.max_accelerated_files = 10000'; \
    echo 'opcache.revalidate_freq = 0'; \
    echo 'opcache.validate_timestamps = 0'; \
} > "$PHP_INI_DIR/conf.d/veritolytics.ini"

# Copy Caddyfile configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Copy application files (legacy-react-prototype is excluded by .dockerignore)
COPY . /app

# Ensure uploads directory structure exists with write permissions
RUN mkdir -p /app/uploads/sessions /app/uploads/avatars /tmp && \
    chmod -R 777 /app/uploads /tmp

# Default PORT environment variable used by Vercel
ENV PORT=8080

# Expose server port
EXPOSE 8080

# Start FrankenPHP using custom Caddyfile
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
